{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@duoquote/polytini": ["../types/index.d.ts"],
      "@duoquote/polytini/presets": ["../types/presets.d.ts"],
      "@duoquote/polytini/flexible": ["../types/flexible.d.ts"],
      "@duoquote/polytini/wasm": ["../types/wasm.d.ts"],
      "@duoquote/polytini/stream": ["../types/stream.d.ts"],
      "@duoquote/polytini/maplibre": ["../types/maplibre.d.ts"],
      "maplibre-gl": ["./node_modules/maplibre-gl/dist/maplibre-gl.d.ts"],
      "geojson": ["./node_modules/@types/geojson/index.d.ts"]
    }
  },
  "include": ["src"],
  // Tests run in Node under vitest, which doesn't typecheck; they use Node types.
  "exclude": ["src/**/*.test.ts", "src/playground/test", "src/playground/formats/testkit.ts"]
}
